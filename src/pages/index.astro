---
import Base from "../layouts/Base.astro";
import Screen from "../components/Screen.astro";
import AppIcon from "../components/AppIcon.astro";
import { GITHUB } from "../lib/site";

// The tour: what a CMO does, each with the screen in KIQR where it happens.
const tour = [
  { eyebrow: "Strategy", title: "Ask it what a CMO would know.", src: "/screens/chat.webp", path: "/chats", alt: "Seemo answering “What should we focus on this quarter?” with three options from the business profile and a recommendation",
    text: ["What to focus on this quarter. Why signups are flat. Which channel to drop. Seemo answers from your business profile, your plan and your numbers, gives its opinion and says where it comes from.", "It never invents facts about the business. If the website doesn't say it and you didn't say it, Seemo doesn't know it."] },
  { eyebrow: "Performance", title: "Every KPI against its target.", src: "/screens/performance.webp", path: "/performance", alt: "The Performance page: plan KPIs with progress against targets, and traffic and search metrics from Google Analytics and Search Console",
    text: ["Google Analytics, Search Console and Plausible are read every morning. Each objective's KPI sits against its target, every metric shows the last 7 days against the 7 before, with the top queries and pages.", "Links KIQR publishes carry UTM tags, so the numbers line up with the campaigns that earned them."] },
  { eyebrow: "Campaigns", title: "The work that moves the numbers.", src: "/screens/library.webp", path: "/library", alt: "The Library: articles, posts, replies, images, memes and ad campaigns, each with its status",
    text: ["Articles, social posts, replies, images and ad campaigns, made for a campaign under an objective. On-brand images are rendered on your machine from your own colours, fonts and logo.", "Everything lands in the library as it will look, and goes out through the channels you connect."] },
  { eyebrow: "Approvals", title: "Nothing goes out without your yes.", src: "/screens/todo.webp", path: "/todo", alt: "The To do page: getting started steps and drafts waiting for approval, each with a channel to approve it for",
    text: ["Plans, campaigns, publishing and settings come to you as cards. To do collects what waits: Seemo's questions, drafts to approve, and what is set to go out.", "Trust a channel, and switch it to publish on its own. The chat records what went out."] },
];

const owns: [string, string, string][] = [
  ["Knows the business, with receipts", "A business profile from your site, each fact linked to the page it came from and kept current when the site changes.", "M9 12l2 2 4-4M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"],
  ["Owns the marketing plan", "Two to four objectives for the period, each with one KPI and a target, and the campaigns under them.", "M4 20V10M10 20V4M16 20v-7M22 20H2"],
  ["Keeps a rhythm", "Recurring work on a schedule: a daily look at the numbers, a weekly review, the posts for the week. Every run is kept with its cost.", "M12 7v5l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"],
  ["Yours, on your machine", "Your own Claude or Codex subscription or API key. Everything is files in a local git repo. Open source, AGPL.", "M4 6h16v10H4zM8 20h8M12 16v4"],
];
const apps: [string, string][] = [["googleanalytics", "Google Analytics"], ["googlesearchconsole", "Search Console"], ["plausibleanalytics", "Plausible"], ["wordpress", "WordPress"], ["email", "Email"], ["unblockingapi", "UnblockingAPI"], ["openai", "OpenAI images"], ["linkedin", "LinkedIn · soon"]];
---
<Base full title="KIQR: Seemo, the CMO that lives on your machine" description="KIQR is an open-source AI CMO that runs on your own computer. Seemo reads your website, proposes a marketing plan with KPIs and targets, measures it with your analytics and runs the campaigns, with every step approved by you.">
  <section class="lp-hero centred">
    <div class="wrap">
      <div class="reveal hero-text">
        <span class="eyebrow">Open source · Runs locally</span>
        <h1>Meet Seemo, <em class="grad-text">your CMO.</em></h1>
        <p class="lead">Give KIQR your website. Seemo learns the business, proposes a marketing plan with KPIs and targets, reads your analytics every morning, and runs the campaigns that move the numbers. You approve every step.</p>
        <div class="row">
          <a href="/docs/install" class="btn primary lg">Get started, free</a>
          <a href="#tour" class="btn lg">See it work</a>
        </div>
        <p class="small">On your own Claude or Codex subscription or API key. No account needed.</p>
      </div>
      <div class="reveal d2 hero-shot">
        <Screen eager src="/screens/plan.webp" path="/plan" alt="KIQR's Plan page: Seemo's Q4 marketing plan with three objectives, each with a KPI and how far it is from its target, and a campaign" />
      </div>
    </div>
  </section>

  <section class="lp-section" id="tour">
    <div class="wrap">
      <div class="reveal">
        <span class="eyebrow">Inside KIQR</span>
        <h2>From your website to a plan, and the plan to results.</h2>
        <p class="intro">Seemo works like a senior marketer who joined this morning and read the whole site before the first meeting. These are the screens it works in with you.</p>
      </div>
      <div class="tour">
        {tour.map((t, i) => (
          <div class={`tour-row${i % 2 ? " flip" : ""}`}>
            <div class="reveal tour-text">
              <span class="eyebrow">{t.eyebrow}</span>
              <h3>{t.title}</h3>
              {t.text.map((p) => <p>{p}</p>)}
            </div>
            <div class="reveal d1"><Screen src={t.src} path={t.path} alt={t.alt} /></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="lp-section">
    <div class="wrap">
      <div class="reveal">
        <span class="eyebrow">What Seemo owns</span>
        <h2>The whole job, not just the posts.</h2>
      </div>
      <div class="feats">
        {owns.map(([title, text, icon], i) => (
          <div class={`feat glow reveal d${i % 4}`}>
            <span class="ic"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon}/></svg></span>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="lp-section">
    <div class="wrap split">
      <div class="reveal">
        <span class="eyebrow">Abilities</span>
        <h2>Connect the numbers and the channels.</h2>
        <p class="intro">Analytics to measure, channels to publish through, image models for photos. Install them in KIQR, or teach Seemo how your team works in plain words.</p>
        <div class="row">
          <a href="/abilities" class="btn primary">Browse abilities</a>
          <a href="/docs/teach" class="btn">Abilities and channels</a>
        </div>
      </div>
      <div class="apps reveal d1">
        {apps.map(([icon, name]) => (
          <div class="app glow"><span class="mono-tile"><AppIcon name={icon} /></span><span class="nm">{name}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="lp-cta slim">
    <div class="wrap">
      <div class="panel glow reveal">
        <span class="eyebrow">kiqr.cloud</span>
        <h2>Connect apps with one click.</h2>
        <p>kiqr.cloud is the optional gateway between your local KIQR and the internet's apps. Sign in once, then connect WordPress, Google Analytics and more without copying a key.</p>
        <div class="row">
          <a href="/cloud" class="btn primary lg">How kiqr.cloud works</a>
        </div>
      </div>
    </div>
  </section>

  <section class="lp-cta">
    <div class="wrap">
      <div class="panel glow reveal">
        <span class="eyebrow">Get started</span>
        <h2>Hire Seemo today.</h2>
        <p>Free and open source. Installs in a few minutes on macOS and Linux, or runs in Docker.</p>
        <div class="row">
          <a href="/docs/install" class="btn primary lg">Install KIQR</a>
          <a href={`${GITHUB}/kiqr`} class="btn lg">GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Base>
