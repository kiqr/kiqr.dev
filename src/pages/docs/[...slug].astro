---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
  return docs.map((doc, i) => ({
    params: { slug: doc.id === "index" ? undefined : doc.id },
    props: { doc, prev: docs[i - 1], next: docs[i + 1], all: docs },
  }));
}

const { doc, prev, next, all } = Astro.props;
const { Content, headings } = await render(doc);
const href = (id: string) => (id === "index" ? "/docs" : `/docs/${id}`);
const sections = [...new Set(all.map((d) => d.data.section))];
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={doc.data.title} description={doc.data.description}>
  <div class="docs wrap">
    <nav class="docs-nav" aria-label="Docs">
      {sections.map((s) => (
        <div>
          <span class="docs-sec">{s}</span>
          {all.filter((d) => d.data.section === s).map((d) => (
            <a href={href(d.id)} class={d.id === doc.id ? "on" : undefined} aria-current={d.id === doc.id ? "page" : undefined}>{d.data.nav ?? d.data.title}</a>
          ))}
        </div>
      ))}
    </nav>
    <article class="prose">
      <span class="eyebrow">{doc.data.section}</span>
      <h1>{doc.data.title}</h1>
      <p class="lead">{doc.data.description}</p>
      <Content />
      <div class="docs-pager">
        {prev ? <a href={href(prev.id)} class="glow"><small>Previous</small>{prev.data.nav ?? prev.data.title}</a> : <span />}
        {next && <a href={href(next.id)} class="glow next"><small>Next</small>{next.data.nav ?? next.data.title}</a>}
      </div>
    </article>
    {toc.length > 2 && (
      <aside class="docs-toc" aria-label="On this page">
        <span class="docs-sec">On this page</span>
        {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
      </aside>
    )}
  </div>
</Base>
