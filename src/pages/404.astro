---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page does not exist on kiqr.dev.">
  <section class="lp-cta">
    <div class="wrap">
      <div class="panel glow">
        <span class="eyebrow">404</span>
        <h2>Nothing here.</h2>
        <p>The page may have moved. The marketplace is now under Abilities.</p>
        <div class="row">
          <a href="/" class="btn primary lg">Home</a>
          <a href="/docs" class="btn lg">Docs</a>
        </div>
      </div>
    </div>
  </section>
</Base>
